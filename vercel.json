{
  "rewrites": [
    {
      "source": "/auth/v1/:path*",
      "destination": "/api/proxy/auth/v1/:path*"
    },
    {
      "source": "/rest/v1/:path*",
      "destination": "/api/proxy/rest/v1/:path*"
    },
    {
      "source": "/storage/v1/:path*",
      "destination": "/api/proxy/storage/v1/:path*"
    },
    {
      "source": "/functions/v1/:path*",
      "destination": "/api/proxy/functions/v1/:path*"
    },
    {
      "source": "/realtime/v1/:path*",
      "destination": "/api/proxy/realtime/v1/:path*"
    }
  ]
}